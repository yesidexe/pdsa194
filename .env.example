# Acceso al panel administrativo
ADMIN_USER=admin
ADMIN_PASSWORD=admin1234

# Opcional: huella PBKDF2 de la contraseña.
# ADMIN_PASSWORD_HASH=sal$huella

# Clave para firmar la sesión del administrador.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Duración de la sesión del administrador en segundos (28800 = 8 horas).
SESSION_MAX_AGE_SECONDS=28800

# Abre la urna automáticamente al arrancar.
AUTO_OPEN_POLLS=true

# Reinicia el servidor al cambiar archivos .py. Solo aplica con python3 -m src.main.
DEV_RELOAD=false

# Dirección y puerto del servidor. Solo aplican con python3 -m src.main.
HOST=127.0.0.1
PORT=8000

# Opcionales
#
# URL de conexión de SQLAlchemy. Si se omite, usa SQLite en e_voting.db.
# DATABASE_URL=sqlite:///ruta/a/otra_base.db
#
# Modalidad inicial: national o university. Por defecto, national.
# ELECTION_MODE=national
