# Archivo de ejemplo. Cópialo a `.env` y cambia los valores:
#   cp .env.example .env
#
# `.env.example` sí se versiona; `.env` está en .gitignore y contiene
# la configuración real de tu máquina.

APP_ENV=local
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Alternativa recomendada: en lugar de ADMIN_PASSWORD, genera un hash con
#   ./venv/bin/python scripts/hash_password.py "mi-clave"
# y pega el resultado aquí. Si existe ADMIN_PASSWORD_HASH, tiene prioridad.
# ADMIN_PASSWORD_HASH=salt$hash

# Clave para firmar la cookie de sesión del administrador.
# Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Duración de la sesión administrativa, en segundos (8 horas).
SESSION_MAX_AGE_SECONDS=28800

# Abre la urna al iniciar el servidor. Para una demo local es cómodo;
# para una jornada controlada, ponlo en false.
AUTO_OPEN_POLLS=true

# Recarga automática de Uvicorn. Déjalo en false para no perder el estado
# de la jornada al guardar cambios.
DEV_RELOAD=false

HOST=127.0.0.1
PORT=8000
